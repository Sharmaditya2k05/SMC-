# Copy to .env.local for development, and set the same keys in Vercel → Settings → Environment Variables.

# Public address of the website (no trailing slash). Used for SEO tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Admin sign-in -----------------------------------------------------------
# Generate the next two values with:  npm run hash-password -- "a long password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Supabase (database + file storage) ---------------------------------------
# Leave empty to use local JSON files in .data/ (development only).
# The service-role key is used on the server only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=smc-files
