# Copy to .env.local for development, and set the same keys in Vercel → Settings → Environment Variables.

# Public address of the website (no trailing slash). Used for SEO tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Admin sign-in -----------------------------------------------------------
# Generate the next two values with:  npm run hash-password -- "a long password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Supabase (database + uploaded files) --------------------------------------
# Leave empty to use local JSON files in .data/ (development only).
# The publishable key is safe to expose; SMC_API_SECRET is not – it is a random
# string of your own (e.g. 64 hex characters) whose SHA-256 hash is stored in
# the app_config table (see supabase/schema.sql). No service-role key is used.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SMC_API_SECRET=
